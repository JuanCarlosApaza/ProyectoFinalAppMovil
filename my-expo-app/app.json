{
  "expo": {
    "name": "RosqMusic",
    "slug": "my-expo-app",
    "version": "1.0.0",
    "newArchEnabled": true,
    "android": {
      "package": "com.carlosexpo.myapp",
      "permissions": [
        "AUDIO_FOCUS",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "WAKE_LOCK",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21"
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Permitir acceso a tu música",
          "savePhotosPermission": "Permitir guardar música",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-audio",
        {
          "android": {
            "stayAwake": true
          }
        }
      ],
      "expo-asset",
      "./plugins/withYouTubeDownloader"
    ]
  }
}
